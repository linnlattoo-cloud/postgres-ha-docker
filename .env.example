# PostgreSQL High Availability Cluster Configuration (.env.example)
# Copy this file to .env and adjust values as needed.
# Usage: cp .env.example .env

# --- Cluster Identity ---
CLUSTER_NAME=postgres-ha-cluster
CLUSTER_SCOPE=postgres-cluster
POSTGRES_VERSION=17

# --- Database Superuser Credentials ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_secure_password_2026

# --- Database Replication User Credentials ---
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator_secure_password_2026

# --- Application Database & User (Optional/Default) ---
POSTGRES_DB=app_db
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=app_secure_password_2026

# --- etcd Configuration ---
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.15
ETCD_CLUSTER_TOKEN=etcd-cluster-token-01

# --- HAProxy Port Mapping & Dashboard ---
HAPROXY_PRIMARY_PORT=5432
HAPROXY_REPLICA_PORT=5433
HAPROXY_STATS_PORT=7070
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=admin_stats_pass_2026

# --- Patroni High Availability Tuning ---
PATRONI_TTL=30
PATRONI_LOOP_WAIT=10
PATRONI_RETRY_TIMEOUT=10
PATRONI_MAX_CONNECTIONS=200
PATRONI_SHARED_BUFFERS=256MB
